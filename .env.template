# ── LLM ──────────────────────────────────────────────────────────
# Google Gemini API. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model id. Swap models here without touching a node.
GROQ_MODEL=gemini-3.5-flash-lite

# ── Web Search ───────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Observability ────────────────────────────────────────────────
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=modus-research-agent

# ── API Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=your_generated_api_key_here

# ── App Config ───────────────────────────────────────────────────
# Where the Streamlit UI reaches the FastAPI backend (read by frontend/app.py).
API_BASE_URL=http://127.0.0.1:8000
# How long the UI waits for a research run before timing out (seconds).
API_TIMEOUT_SECONDS=300
# Per-client rate limit on POST /api/research (read by backend/main.py).
API_RATE_LIMIT=10/minute
DATABASE_PATH=./research.db
FAISS_INDEX_PATH=./faiss_index
